use hui
use os
use yrenderer
use simplevis as sv
use image.Painter
use .mesh
use .common.Mesh


func create_vb(m: Mesh) -> xfer[yrenderer.VertexBuffer]
	var vb = new yrenderer.VertexBuffer("3f,3f,2f|i32")
	vb.update(m.vertices)
	print(len(m.vertices))
	vb.update_index(m.indices)
	return give(vb)


class Canvas extends sv.Canvas
	var m: mesh.Mesh
	var vb: owned![yrenderer.VertexBuffer]
	var material: yrenderer.Material&

	func __init__(filename: os.Path)
		m = mesh.load(filename)!

	func override on_initialize()
		vb = create_vb(m)
		material := ctx.create_material()
		cam.focus_on_box(m.bounding_box())

	func override on_draw()
		ctx.set_color(Color.GRAY)
		ctx.draw_wire_box(m.bounding_box())
		ctx.draw_mesh(vb, mat4.ID, material)

	func override on_draw_2d(out p: Painter)
		p.set_color(Color.GRAY)
		p.set_font_size(10)
		p.draw_str([20,20], "{{len(m.vertices)}} vertices")

	func override on_key_down(k: int)
#		if k == hui.KEY_W
#			wireframe = not wireframe
#			request_redraw()



func explore(arg: string[])
	sv.run(new Canvas(arg[0]), arg[0])


func main(arg: string[])
	var p = new os.CommandLineParser()
	p.info("mesh-view", "...")
##	p.cmd("-h/--help", "", "show help", func(a: string[]) p.show()) # FIXME kaba
	p.cmd("", "FILENAME", "mesh to show", explore)
	p.parse(arg)!

