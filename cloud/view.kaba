use os
use image
use .cloud
use simplevis as sv
use simplevis.canvas
use simplevis.cloud.PointCloudRenderer


func large_num(i: int) -> string
	let s = str(i)
	if len(s) > 6
		return s[:-6] + "," + s[-6:-3] + "," + s[-3:]
	if len(s) > 3
		return s[:-3] + "," + s[-3:]
	return s


class Canvas extends canvas.Canvas
	var cr = PointCloudRenderer(&ctx)
	var points: vec3[]

	func __init__(filename: os.Path)
		points = cloud.get_points(cloud.load(filename)!)

	func override on_initialize()
		cr.initialize()

		cr.set_points(points)
		cam.focus_on_box(cr.bounds)
		cr.R = 5

	func override on_draw()
		cr.draw()

	func override on_draw_2d(out p: image.Painter)
		p.set_color(Color.GRAY)
		p.set_font_size(10)
		p.draw_str([20,20], "{{large_num(len(points))}} points")


func view_cloud(args: string[])
	for a in args
		sv.run(new Canvas(a), a)


func main(args: string[])
	var p = new os.CommandLineParser()
	p.info("view", "show a point cloud file")
##	p.cmd("-h/--help", "", "show help", func(a: string[]) p.show()) # FIXME kaba
	p.cmd("", "FILE", "...", func(a: string[]) view_cloud(a))
	p.parse(args)!
