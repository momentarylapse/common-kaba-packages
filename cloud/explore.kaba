use hui
use yrenderer
use os
use obs
use image
use image.Image
use cloud
use simplevis as sv
use simplevis.cloud.PointCloudRenderer
use simplevis.grid.GridRenderer
use .helper.filepanel.*


func large_num(i: i32) -> string
	let s = str(i)
	if len(s) > 6
		return s[:-6] + "," + s[-6:-3] + "," + s[-3:]
	if len(s) > 3
		return s[:-3] + "," + s[-3:]
	return s


class MyCanvas extends sv.Canvas
	var out_key_pressed = obs.XSource[i32](&self, &ind, "key-pressed")
	var cloud_renderer = PointCloudRenderer(&self)
	var grid = GridRenderer(&self)
	var points: vec3[]
	var num_files_selected = 0


	func override on_initialize()
		cloud_renderer.initialize()

		cloud_renderer.set_points(points)
		cloud_renderer.R = 2
		cam.ang = Quaternion([2.0,0,0])
		cam.focus_on_box(cloud_renderer.bounds)


	func mut update_cloud_renderer()
		cloud_renderer.set_points(points)
		request_redraw()


	func mut set_points(p: vec3[])
		points = p
		update_cloud_renderer()
		request_redraw()


	func override on_key_down(k: i32)
		if k == hui.KEY_CONTROL + hui.KEY_B
			cloud_renderer.R = loop(cloud_renderer.R+1, 1.0, 4.0)
			request_redraw()
		if k == hui.KEY_C
			cam.pos = cloud.center_of_mass(points)
			set_message("jump to center")

		out_key_pressed(k)


	func override on_draw()
		grid.draw()
		cloud_renderer.draw()


	func override on_draw_2d(out p: image.Painter)
		p.set_font("", 14, false, false)
		p.set_color(Color.WHITE)
		p.draw_str([20,20], "{{large_num(len(points))}} points  {{num_files_selected}} files")
		p.set_color(Color.GRAY)
		p.set_font("", 10, false, false)
		p.draw_str([20,40], "cam: {{cam.pos}}")



class MyWindow extends hui.Window as obs.Node
	var canvas: shared![MyCanvas]
	var file_panel: shared![FilePanel]

	func __init__(dir: os.Path)
		super.__init__("Cloud explorer", 1200, 800)

		# fixed ui layout
		from_source("
Window win '' borderwidth=0
	Grid root ''
		Overlay ? '' expandx expandy
			Grid main-grid '' expandx expandy
				.
			Grid ? '' margin=50 spacing=30
				Label ? '' expandy
				---|
				Grid buttons '' class=card
				Label ? '' expandx

		Grid side-panel '' expandy width=300
			.
")

		set_maximized(true)

		set_target("buttons")

		# some extra commands
		event("export-cloud", on_export_cloud)
		set_key_code("export-cloud", hui.KEY_CONTROL + hui.KEY_E)

		# the 3d rendering canvas
		canvas = new MyCanvas()
		embed("main-grid", 0, 0, canvas)

		# file selection
		file_panel = new FilePanel(dir)
		embed("side-panel", 0, 0, file_panel)
		file_panel.out_selected >> create_data_sink[os.Path[]](func(files: os.Path[])
			load(files)
		end)

		# show something...
		if len(file_panel.all_files) == 0
			canvas.set_message("no pcd files in {{dir}}")
		load(file_panel.get_selected())
		canvas.cloud_renderer.set_good_camera(canvas)
#		canvas.cam.pos = [170.03, 48.2536, -2.75144]


#	func mut on_key_down_x(k: i32)
#		if k == xhui.KEY_PAGE_DOWN
#			load([loop(current[0]+1, 0, len(files))], true)
#		if k == xhui.KEY_PAGE_UP
#			load([loop(current[0]-1, 0, len(files))], true)


	func mut load(files: os.Path[])
		var points: vec3[]
		for f in files
			points |= cloud.get_points(cloud.load(cloud.quick_file(f))!)
	#	points = cloud.random_sample(points, 100000)
		canvas.set_points(points)
		canvas.num_files_selected = len(files)


	func on_export_cloud()
		hui.file_dialog(&self, "export cloud", "./", ["filter=*.pcd", "save"]).then(func(filename: os.Path)
			cloud.save(cloud.from_points(canvas.points), filename)!
		end)



func explore(arg: string[])
	hui.fly_and_wait(new MyWindow(arg[0]))


func main(arg: string[])
	var p = new os.CommandLineParser()
	p.info("explore", "gallery of cloud data sets")
##	p.cmd("-h/--help", "", "show help", func(a: string[]) p.show()) # FIXME kaba
	p.cmd("", "DIR", "show all pcds in a directory", explore)
	p.parse(arg)!

