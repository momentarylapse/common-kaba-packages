use xhui
use os
use image
use obs
use simplevis
use simplevis.cloud.*
use simplevis.grid.GridRenderer
use .cloud


func large_num(i: int) -> string
	let s = str(i)
	if len(s) > 6
		return s[:-6] + "," + s[-6:-3] + "," + s[-3:]
	if len(s) > 3
		return s[:-3] + "," + s[-3:]
	return s


func is_cloud_file(f: os.Path) -> bool
	return f.extension() in ["pcd", "ply"]





class CloudRenderCanvas extends simplevis.Canvas
	var cloud_renderer = PointCloudRenderer(&ctx)
	var grid = GridRenderer(&ctx, &cam)
	var points: cloud.Point[]
	var current: i32[]

	func override __init__()

	#	cloud_renderer.set_good_camera(self, cloud.get_points(points))
		#cam_pos = [170.03, 48.2536, -2.75144]

	#	on_post_init(init_data)

	func override on_initialize()
		cloud_renderer.initialize()
		update_cloud_renderer()


	func override mut on_draw()
		grid.draw()
	#	draw_magic_grid([0.5,0.5,0.5, 1])
		cloud_renderer.draw()


	func override mut on_draw_2d(out p: image.Painter)
		p.set_font("", 14, false, false)
		p.set_color(Color.WHITE)
		p.draw_str([0,10], "{{large_num(len(points))}} points  {{len(current)}} files")
		p.set_color(Color.GRAY)
		p.set_font_size(10)
		p.draw_str([0,30], "cam: {{cam.pos}}")


	func override mut on_key_down(k: i32)
		if k == xhui.KEY_PAGE_DOWN
			pass #load([loop(current[0]+1, 0, len(cfg.files))], true)
		if k == xhui.KEY_PAGE_UP
			pass #load([loop(current[0]-1, 0, len(cfg.files))], true)
		if k == xhui.KEY_CONTROL + xhui.KEY_B
			cloud_renderer.R = loop(cloud_renderer.R+1, 1.0, 4.0)
	#	if k == xhui.KEY_CONTROL + xhui.KEY_E
	#		export_cloud()
		if k == xhui.KEY_C
			cam.pos = cloud.center_of_mass(cloud.get_points(points))
			set_message("jump to center")
		if k == xhui.KEY_1
			cloud_renderer.color_mode = ColorMode.AUTO
			request_redraw()
			set_message("color mode: auto")
		if k == xhui.KEY_2
			cloud_renderer.color_mode = ColorMode.INTENSITY
			request_redraw()
			set_message("color mode: intensity")


	func mut update_cloud_renderer()
		cloud_renderer.set_points(points)

	func mut set_points(p: cloud.Point[])
		points = p
		update_cloud_renderer()



class MyWindow extends xhui.Window as obs.Node
	var canvas: shared![CloudRenderCanvas]
	var current: i32[]

	func __init__()
		super.__init__("Cloud explorer", 800, 600)

		set_maximized(true)

		from_source("
Window win 'Cloud explorer' borderwidth=0
	Grid main-grid ''
		.
		Grid side-panel ''
			ListView list 'files' nobar width=250 selectmulti'")

		canvas = new CloudRenderCanvas()
		embed("main-grid", 0, 0, canvas)

		canvas.out_redraw >> create_sink(func() redraw("area"))

		for mut list in get_control("list") as xhui.ListView*
			list.column_factory(0).set_create(func(id: string) xhui.create_control("Label", "!markup", id))

		for f in cfg.files
			if f.extension() == "ply" and os.Path(f.basename_no_ext() + ".pcd") in cfg.files
				add_string("list", "<span size='x-small' alpha='50%'>" + str(f) + "</span>")
			else
				add_string("list", "<span size='x-small'>" + str(f) + "</span>")
		event_x("list", "hui:select", on_list)

		load([cfg.initial_file], true)

	#	cloud_renderer.set_good_camera(self, cloud.get_points(points))
		#cam_pos = [170.03, 48.2536, -2.75144]

	#	on_post_init(init_data)


	func mut load(i: i32[], update_ui: bool)
		current = i
		var points: cloud.Point[]
		for c in current
			points |= cloud.load(cloud.quick_file(cfg.dir | cfg.files[c]))!
		canvas.set_points(points)
		canvas.current = current
	#	print(points |> (func(p: cloud.Point) p.intensity))

	#	if update_ui
	#		set_selection("list", current)

	func mut on_list()
		let i = get_int("list")
		load([i], false)

	func export_cloud()
		let f = func(filename: os.Path)
			cloud.save(canvas.points, filename)!
	#	hui.file_dialog_save(&self, "export cloud", "./", ["filter=*.pcd"]).then(f)


class Config
	var dir: os.Path
	var files: os.Path[]
	var initial_file = 0
var cfg: Config


func explore(arg: string[])
	let path: os.Path = arg[0]
	if os.fs.is_directory(path)
		cfg.dir = path
	else
		cfg.dir = path.parent()

	cfg.files = os.fs.search(cfg.dir, "*", "f")
		|> filter(f => is_cloud_file(f))

	if len(cfg.files) == 0
		raise Error("no cloud files in {{cfg.dir}}")

	if not os.fs.is_directory(path)
		let bn = path.basename()
		for i=>f in cfg.files
			if f == bn
				cfg.initial_file = i

	xhui.fly_and_wait(new shared MyWindow())


func main(arg: string[])
	var p = new os.CommandLineParser()
	p.info("explore", "gallery of cloud data sets")
##	p.cmd("-h/--help", "", "show help", func(a: string[]) p.show()) # FIXME kaba
	p.cmd("", "FILE_OR_DIR", "show all cloud files in a directory", func(a: string[]) explore(a))
	p.parse(arg)!

