enum Type
	DUMMY
	NUMBER
	FLOAT
	CONSTANT
	VARIABLE
	OPERATOR
	FUNCTION
	SPECIAL
	LIST
#	SET


enum CharType
	LETTER
	NUMBER
	SIGN
	WHITESPACE


var num_terms: int


struct Term
	var type: Type
	var name: string
	var params: Term[]

	func __init__()
	func __init__(_type: Type, _name: string)
		type = _type
		name = _name
		#print("new Term {{type}} {{name}}")


	func __str__() -> string
		if type == Type.OPERATOR
			var a = str(params[0])
			var b = str(params[1])
			if param_needs_paranthesis(0)
				a = "({{a}})"
			if param_needs_paranthesis(1)
				b = "({{b}})"
			if name == "*"
				return "{{a}} {{b}}"
			else if name == "^"
				return a + name + b
			else
				return "{{a}} {{name}} {{b}}"
		else if type == Type.NUMBER
			return name
		else if type == Type.FLOAT
			return name
		else if type == Type.VARIABLE
			return name
		else if type == Type.CONSTANT
			return name
		else if type == Type.FUNCTION
			return name + "(" + [for p in params str(p)].join(", ") + ")"
		else if type == Type.SPECIAL
			return "{{name}} " + str(params[0])
		else if type == Type.LIST
			return "[" + [for p in params str(p)].join(", ") + "]"
		return "?"


	func param_needs_paranthesis(index: int) -> bool
		let p = &params[index]
		if p.type == Type.NUMBER
			if p.name[:1] == "-"
				return true
		if name == "^"
			return p.type == Type.OPERATOR
		if name == "/"
			if p.name == "^"
				return false
			return p.type == Type.OPERATOR
		if name == "-"
			if p.name == "*"
				return false
			return p.type == Type.OPERATOR
		if name == "*"
			return p.name in ["+", "-"]
		return false

	# not usable... float(shared[Term]) :(
	func __float__() -> f32
		return float(name[:10])


#shared Term[] copy_list(shared Term[] list)
#	return [for t in list t.copy()]


func AddNumber(s: string) -> Term
	return Term(Type.NUMBER, s)

func AddFloat(s: string) -> Term
	return Term(Type.FLOAT, s)

func AddVariable(s: string) -> Term
	return Term(Type.VARIABLE, s)

func AddConstant(s: string) -> Term
	return Term(Type.CONSTANT, s)

func AddOperator(s: string, p1: Term, p2: Term) -> Term
	var t = Term(Type.OPERATOR, s)
	t.params.add(p1)
	t.params.add(p2)
	return t

func AddFunction(s: string, params: Term[]) -> Term
	var t = Term(Type.FUNCTION, s)
	t.params = params
	return t

func PermuteOperator(t: Term) -> Term
	var r = t
	r.params[0] = t.params[1]
	r.params[1] = t.params[0]
	return r

func AddSpecial(s: string, params: Term[]) -> Term
	var t = new Term(Type.SPECIAL, s)
	t.params = params
	return t

func AddList(params: Term[]) -> Term
	var t = Term(Type.LIST, "-list-")
	t.params = params
	return t

