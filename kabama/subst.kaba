use .common.*

# always copy
func subst_variable(_t: Term, _var: string, by: Term) -> Term
	var t = _t
	for mut p in t.params
		p = subst_variable(p, _var, by)

	if t.type == Type.VARIABLE
		if t.name == _var
			return by
	return t



struct MatchingTerm
	var t: Term
	var name: string
	func __str__() -> string
		return "{{name}} -> {{t}}"

struct Matching
	var terms: MatchingTerm[]
	func mut add(t: Term, name: string) -> bool
		#print("add: {{t}} <<< {{name}}")
		var mt: MatchingTerm
		mt.t = t
		mt.name = name
		terms.add(mt)
		return true
	func __str__() -> string
		return str([for t in terms str(t)])


func rule_match(t: Term, m: Term, out mm: Matching) -> bool
	if m.name[:1] == "@"
		mm.add(t, m.name)
		return true
	if t.name != m.name
		return false
	if len(t.params) != len(m.params)
		return false
	for i=>p in t.params
		if !rule_match(p, m.params[i], mm)
			return false
	return true


func subst(_t: Term, pattern: Term, substitution: Term, max_recursion: i32) -> Term
	var mm: Matching
	var t = _t
	for mut p in t.params
		p = subst(p, pattern, substitution, max_recursion)

	if rule_match(t, pattern, mm)
		#print("MATCH!!!!")
		#print(str(mm))

		var r = substitution
		for x in mm.terms
			r = subst_variable(r, x.name, x.t)
		if max_recursion > 0
			return subst(r, pattern, substitution, max_recursion-1)
		return r

	return t
