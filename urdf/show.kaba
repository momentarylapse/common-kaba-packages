use .urdf
use hui
use os
use image.Painter
use simplevis as sv
use simplevis.grid.GridRenderer
use simplevis.label.LabelManager


enum GraphMode
	SIMPLE
	REAL


func edge_color(t: urdf.Edge.Type) -> Color
	return match t
		urdf.Edge.Type.FIXED =>     Color(0.9, 0.1, 0.1)
		urdf.Edge.Type.FLOATING =>  Color(0.8, 0.8, 0.1)
		urdf.Edge.Type.REVOLUTE =>  Color(0.2, 0.9, 0.2)
		urdf.Edge.Type.PRISMATIC => Color(0.3, 0.3, 1)


class MyCanvas extends sv.Canvas
	var grid = GridRenderer(&self)
	var label_manager = LabelManager(&self)
	var tree: urdf.Tree
	var graph_mode = GraphMode.REAL
	var show_labels = true
	var show_frames = false

	var matrices: mat4{}


	func __init__(t: urdf.Tree)
		tree = t
		matrices = tree.default_matrices()


	func mut draw_node(n: string)
		let matrix = matrices[n]!
		let is_root = tree.is_root_node(n)

		for e in tree.edges
			if e.parent == n
				draw_node(e.child)
				ctx.set_color(edge_color(e.type))
				let child_matrix = matrices[e.child]!
				ctx.draw_lines([matrix * vec3.0, child_matrix * vec3.0], sv.LineMode.PATH)

		if show_frames
			let l = cam.radius * 0.03
			ctx.set_color([0.8,0,0,1])
			ctx.draw_lines([matrix * vec3.0, matrix * [l,0,0]], sv.LineMode.PATH)
			ctx.set_color([0,0.7,0,1])
			ctx.draw_lines([matrix * vec3.0, matrix * [0,l,0]], sv.LineMode.PATH)
			ctx.set_color([0.2,0.2,1,1])
			ctx.draw_lines([matrix * vec3.0, matrix * [0,0,l]], sv.LineMode.PATH)

		let p = matrix * vec3.0
		let c = if is_root
			Color(0.8, 0.1, 0.1)
		else
			Color.WHITE
		if show_labels
			label_manager.add(p, n, Color.mix(c, Color.GRAY, 0.3))
		ctx.set_color(c)
		ctx.draw_wire_cube(p, cam.radius / 400)


	func override on_draw()
		grid.draw()

		var y0 = 0
		for n in tree.root_nodes()
			draw_node(n)


	func override on_draw_2d(out p: Painter)
		p.set_font("", 14, false, false)
		p.set_color(Color.WHITE)
		p.draw_str([20,20], "{{len(tree.nodes)}} nodes,  {{len(tree.edges)}} edges")
		p.set_color(Color.GRAY)
		p.set_font("", 10, false, false)
#		p.draw_str([20,40], "cam: {{cam.pos}}")
		p.set_font("", 12, true, false)
		label_manager.draw(p, [10, 10])

		# legend
		p.set_font("", 12, false, false)
	#	for i=>t in urdf.Edge.Type.all()   FIXME!
		let types = [urdf.Edge.Type.FIXED, urdf.Edge.Type.FLOATING, urdf.Edge.Type.PRISMATIC, urdf.Edge.Type.REVOLUTE]
		for i=>t in types
			p.set_color(edge_color(t))
			p.draw_str([20, p.area().height() - 40 - i*30], str(t).lower())


	func mut update_matrix_simple(n: string, level: i32, out y0: i32)
		matrices[n] = mat4.translation([level, y0, 0])
		y0 ++
		for e in tree.edges
			if e.parent == n
				update_matrix_simple(e.child, level + 1, y0)


	func mut update_matrices_simple()
		var y0 = 0
		for n in tree.root_nodes()
			update_matrix_simple(n, 0, y0)


	func override on_key_down(k: i32)
		if k == hui.KEY_1
			graph_mode = GraphMode.SIMPLE
			update_matrices_simple()
		if k == hui.KEY_2
			graph_mode = GraphMode.REAL
			matrices = tree.default_matrices()
		if k == hui.KEY_F
			show_frames = not show_frames
			set_message("show frames: {{show_frames}}")
			request_redraw()
		if k == hui.KEY_L
			show_labels = not show_labels
			set_message("show labels: {{show_labels}}")
			request_redraw()



func explore(arg: string[])
	sv.run(new MyCanvas(urdf.parse(arg[0])), arg[0])



func main(arg: string[])
	var p = new os.CommandLineParser()
	p.info("show-urdf", "view a urdf file")
##	p.cmd("-h/--help", "", "show help", func(a: string[]) p.show()) # FIXME kaba
	p.cmd("", "URDF_FILE", "show urdf file", explore)
	p.parse(arg)!


