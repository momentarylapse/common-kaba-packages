use os
use kaba
use image
use obs
use xhui as hui
use yrenderer.*
use .common.*


let UPDATE_DT = 0.02


class SimpleEmitter extends MeshEmitter
	var canvas: Canvas&
	var xx_vb: owned![VertexBuffer]
	var xx_mat: Material&

	func __init__(out c: Canvas&)
		super.__init__(c.ctx.ctx, "simple")
		canvas := c
		xx_vb = new VertexBuffer("3f,3f,2f")
		xx_mat := c.ctx.create_material()

	func override prepare(params: RenderParams)
		canvas.ctx.cur_params := &params
		canvas.on_prepare()

	func override emit(params: RenderParams, rvd: RenderViewData, shadow_pass: bool)
		canvas.ctx.cur_params := &params
		canvas.ctx.cur_rvd := &rvd
		canvas.ctx.shadow_pass = shadow_pass
		canvas.ctx.lines.begin_draw(params, rvd)

		# FIXME bug: lines only visible AFTER drawing a mesh :[
		canvas.ctx.draw_mesh(xx_vb, mat4.ID, xx_mat)

		canvas.on_draw()
		if canvas.f_draw
			canvas.f_draw()
		canvas.on_draw_transparent() # meh later...
		if canvas.f_draw_transparent
			canvas.f_draw_transparent()


class ViewPort extends Object as obs.Node
	var out_changed = obs.Source(&self, &ind, "changed")
	var pos = vec3.0
	var ang = Quaternion.ID
	var radius = 5.0
	var fov = pi/4

	func mut rotate(d: Quaternion)
		ang = ang * d
		out_changed()

	func mut move(d: vec3)
		pos += ang * d * radius
		out_changed()

	func mut zoom(f: f32)
		radius /= f
		out_changed()

	func mut focus_on_box(box: Box)
		pos = box.center()
		radius = len(box.size()) * 1.5
		out_changed()

	func params() -> CameraParams
		return (pos - ang * [0,0,radius], ang, fov, radius*0.01, radius*1000)


class Canvas extends hui.Panel as obs.Node
	var out_redraw = obs.Source(&self, &ind, "redraw")
	var yctx: owned![Context]
	var ctx: SimpleContext
	var xhui_renderer: owned[XhuiRenderer]
	var hdr: owned[HDRResolver]
	var render_path: owned[RenderPath]
	var light: YLight
	var emitter: shared[SimpleEmitter]
	var cam: ViewPort
	var light_cam_ang: Quaternion?
	var f_draw: void->void = nil
	var f_draw_transparent: void->void = nil
	var animation_request_level = 0
	var animation_id = -1
	var message: string
	var message_ttl = -1.0

#	enum MouseMode
#		NONE
#		ROTATE
#		MOVE
#	var mode = MouseMode.NONE


	func __init__()
		super.__init__("")
		from_source("
Dialog canvas ''
	DrawingArea area '' expandy cangrabfocus grabfocus
")
		cam.out_changed >> create_sink(func() out_redraw())

		event_x("area", "hui:mouse-move", xmouse_move)
		event_x("area", "hui:mouse-wheel", xmouse_wheel)
		event_x("area", "hui:key-down", xkey_down)

		event_x("area", "hui:draw", xdraw)
		event_x("area", "hui:initialize", xinitialize)



	func mut xinitialize(out p: hui.Painter)
		yctx = api_init_xhui(&p)
		yctx.create_managers([], [kaba.packages_root() | "yrenderer/shader", kaba.packages_root() | "simplevis/shader"], [])
		initialize(weak(yctx))

		for mut w in get_window()
			let _ = w.event_x("win", "hui:just-before-draw", xbefore_draw)


	func mut begin_animation()
		animation_request_level ++
		if animation_request_level == 1
			animation_id = hui.run_repeated(UPDATE_DT, func() out_redraw())


	func mut end_animation()
		animation_request_level --
		if animation_request_level == 0
			hui.cancel_runner(animation_id)


	func mut clear_message()
		message = ""
		message_ttl = -1.0
		end_animation()
		# direct out_redraw() not working...
		hui.run_later(0.01, func() out_redraw())


	func mut set_message(m: string)
		if message != ""
			clear_message()
		message = m
		message_ttl = 2.0
		begin_animation()


	func mut xbefore_draw(out p: hui.Painter)
		before_draw(p)


	func mut xdraw(out p: hui.Painter)
		draw(p)


	func mut xmouse_move()
		for w in get_window()
			on_mouse_move(w.get_mouse_delta(), w.left_button(), w.middle_button(), w.right_button())


	func mut xmouse_wheel()
		for w in get_window()
			on_mouse_wheel(w.get_scroll())


	func mut xkey_down()
		for w in get_window()
			on_key_down(w.get_key_code())


	# interface
	func virtual mut on_initialize()
	func virtual mut on_prepare()
	func virtual mut on_draw()
	func virtual mut on_draw_transparent()
	func virtual mut on_draw_2d(out p: image.Painter)
#	func override on_mouse_move(m: vec2)

	func mut initialize(c: Context&)
		ctx.ctx := c
		xhui_renderer = new XhuiRenderer(ctx.ctx)


		hdr = new HDRResolver(ctx.ctx, 1920, 1080) # TODO dynamically adapt to window size...
#		hdr.bloom_factor = 10

		render_path = new RenderPathForward(ctx.ctx, 1024)
		#render_path = new RenderPathDeferred(ctx.ctx, 130, 100, 1024)
		render_path!.background_color = [0.2,0.2,0.2,1]

		xhui_renderer!.add_child(hdr!)
		hdr!.add_child(render_path!)

		ctx.lines = new LineHelper()

		emitter = new SimpleEmitter(&self)
		render_path!.add_opaque_emitter(emitter!)


		light.init(LightType.DIRECTIONAL, [1,1,1,1])
#		light.allow_shadow = true
		light_cam_ang = Quaternion([0.5, -0.4, 0])

		on_initialize()

		hui.run_later(0.1, func() out_redraw())


	func mut before_draw(out p: hui.Painter)
		for mut r in xhui_renderer
			let params = r.extract_params(&p)

			for da in light_cam_ang
				light.ang = cam.ang * da

			render_path!.set_view(cam.params())
			render_path!.set_lights([&light])

			r.before_draw(&p)
			ctx.lines.start_frame(p.ui_scale)


	func mut draw(out p: hui.Painter)
		for mut r in xhui_renderer
			r.draw(&p)
		on_draw_2d(p)
		if message_ttl >= 0
			p.set_font_size(20)
			p.set_color(Color.WHITE.with_alpha(min(message_ttl*5, 1.0)))
			p.draw_str(p.area().center() - p.get_str_size(message)/2, message)
			message_ttl -= UPDATE_DT
			if message_ttl < 0
				clear_message()


	func virtual mut on_mouse_move(d: vec2, lbut: bool, mbut: bool, rbut: bool)
		if rbut
			cam.rotate(Quaternion(vec3(d.y, d.x, 0) * 0.003))
		if mbut
			cam.move(vec3(-d.x, d.y, 0.0) * 0.001)


	func override on_mouse_wheel(d: vec2)
		cam.zoom(exp(d.y * 0.1))


	func override on_key_down(k: i32)
		if k == hui.KEY_LEFT
			cam.move([-0.05,0,0])
		if k == hui.KEY_RIGHT
			cam.move([0.05,0,0])
		if k == hui.KEY_UP
			cam.move([0,0.05,0])
		if k == hui.KEY_DOWN
			cam.move([0,-0.05,0])


	func mut set_background(b: Color)
		render_path!.background_color = b


	func mut set_hdr_exposure(exposure: f32)
		hdr!.exposure = exposure
