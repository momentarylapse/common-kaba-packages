use simplevis as sv
use yrenderer.*
use polymesh.*


class Canvas extends sv.Canvas
	var vb: owned![VertexBuffer]
	var tex: shared![Texture]
	var material: Material&

	var shader: shared![Shader]
	var ct: owned![ComputeTask]
	var roll = 0.8


	func override on_initialize()
		light.color = [1,1,1,1]
		animated = true

		vb = sv.mesh_to_vb(create_cube(Box.ID_SYM, [1,1,1]))
		tex = new StorageTexture(16, 16, 1, "rgba:i8")

		material := ctx.create_material()
		material.textures[0] = tex

		shader = ctx.ctx.create_shader("
<Layout>
	version = 430
	bindings = [[image]]
	pushsize = 4
</Layout>
<ComputeShader>

#if vulkan
layout(push_constant) uniform PushConstants { float roll; };
#else
uniform float roll;
#endif
layout(binding=0, rgba8) uniform writeonly image2D image;
layout(local_size_x=16, local_size_y=16) in;

void main() {
	ivec2 storePos = ivec2(gl_GlobalInvocationID.xy);
	float localCoef = length(vec2(ivec2(gl_LocalInvocationID.xy)-8)/8.0);
	float globalCoef = sin(float(gl_WorkGroupID.x+gl_WorkGroupID.y)*0.1 + roll)*0.5;
	imageStore(image, storePos, vec4(localCoef, abs(sin(roll)), 0, 1.0));
}
</ComputeShader>")

		ct = new ComputeTask(ctx.ctx, "compute", shader, [16,16])
		ct.bind_image(0, weak(tex))


	func override on_prepare()
		roll += 0.08
		ct.shader_data = dyn({"roll:0": roll})
		ct.render(ctx.cur_params)


	func override on_draw()
		ctx.draw_mesh(weak(vb), mat4.ID, material)


func main()
	sv.run(new Canvas())
