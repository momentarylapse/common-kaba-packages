use yrenderer
use yrenderer.gfx
use .common.*
use .canvas.*
use cloud


enum ColorMode
	AUTO
	FIXED
	INTENSITY


class PointCloudRenderer
	var ctx: SimpleContext&
	var bounds: Box

	# "regular" clouds
	var cloud_vb: owned[gfx.VertexBuffer]
	var cloud_max_intensity = 1.0
	var color_mode = ColorMode.AUTO
	var color = Color.WHITE

	# clouds with explicit color
	var cloud_color_shader: shared![gfx.Shader]
	var cloud_color_vb: owned![gfx.VertexBuffer]
	var cloud_color_buf: (vec3,Color)[]
	var cloud_color_dirty = false

	var matrix = mat4.ID
	var material: owned![yrenderer.Material]

	var R = 2.0


	func mut __init__()
	func mut __init__(_ctx: SimpleContext&)
		ctx := _ctx


	func mut draw()
		var shader = ctx.cur_rvd.get_shader(weak(material), 0, "point-cloud-default", "point-cloud")
		var rd = ctx.cur_rvd.start(ctx.cur_params, matrix, shader, weak(material), 0, gfx.PrimitiveTopology.POINTS, weak(cloud_vb)!)

		var data: Any
		data["dx:0"] = R / ctx.cur_params.area.height() / ctx.cur_params.desired_aspect_ratio
		data["dy:4"] = R / ctx.cur_params.area.height()
		data["color_mode:8"] = i32(color_mode)
		data["vmin:16"] = dyn(bounds.min)
		data["vmax:32"] = dyn(bounds.max)
		data["color_fixed:48"] = dyn(color)
		yrenderer.apply_shader_data(ctx.cur_params, shader, data)
		rd.draw(ctx.cur_params, weak(cloud_vb)!, gfx.PrimitiveTopology.POINTS)


#		if cloud_color_dirty
#			cloud_color_vb.update(cloud_color_buf)
#			cloud_color_dirty = false
#
#		gl.set_shader(cloud_color_shader)
#		cloud_color_shader.set_float("dx", R / gl.target.width())
#		cloud_color_shader.set_float("dy", R / gl.target.height())
#		gl.draw_points(cloud_color_vb)


	func set_good_camera(out c: Canvas)
		c.cam.focus_on_box(bounds)


	func mut set_points(points: vec3[])
		set_points(points |> (func(p: vec3) cloud.Point(p, 1.0)))


	func mut set_points(points: cloud.Point[])
		bounds = cloud.bounding_box(cloud.get_points(points))
		if bounds.size().x == 0
			bounds.min.x -= 0.5
			bounds.max.x += 0.5
		if bounds.size().y == 0
			bounds.min.y -= 0.5
			bounds.max.y += 0.5
		if bounds.size().z == 0
			bounds.min.z -= 0.5
			bounds.max.z += 0.5
		cloud_max_intensity = points |> (func(p: cloud.Point) p.intensity) |> max


		for mut vb in cloud_vb
			vb.update(points)


	func mut add_color_point(p: vec3, c: Color)
		cloud_color_buf.add([p,c])
		cloud_color_dirty = true


	func mut initialize()
		material = new yrenderer.Material()
		material.pass0.shader_path = "point-cloud.shader"
		material.pass0.cull_mode = gfx.CullMode.NONE
	#	material.pass0.mode = yrenderer.TransparencyMode.FUNCTIONS
	#	material.pass0.source = gfx.Alpha.SOURCE_ALPHA
	#	material.pass0.destination = gfx.Alpha.SOURCE_INV_ALPHA
	#	material.pass0.z_write = true
	#	material.pass0.z_test = true

		ctx.ctx.load_shader_module("module-point-cloud-data.shader")!
		ctx.ctx.load_shader_module("module-vertex-point-cloud-default.shader")!
		ctx.ctx.load_shader_module("module-geometry-point-cloud.shader")!

		cloud_vb = new gfx.VertexBuffer("3f,f")

#		cloud_color_vb = new gfx.VertexBuffer("3f,4f")

