use os
use kaba
use .common.*
use .install.*


func repo_is_clean(dir: os.Path) -> bool
	return os.shell_execute("cd {{dir}}; git status --short -uno")! == ""


func repo_is_ahead(dir: os.Path) -> bool
	return os.shell_execute("cd {{dir}}; git status --short -uno -b")!.explode("\n")[0].find(" [ahead ").has_value()


func repo_pull(dir: os.Path, rebase: bool)
	if rebase
		let r = os.shell_execute("cd {{dir}}; git pull --rebase")!
	else
		let r = os.shell_execute("cd {{dir}}; git pull")!


func action_pull(args: string[])
	for s in conf.sources
		let base = s.base_path()

		print("updating repo {{s.name}}")

		# dir missing?
		if not os.fs.is_directory(base)
			if s.user_managed()
				warn("repo not found: {{base}}")
				continue
			else
				os.fs.create_directory(base)!

		# not git?
		if not os.fs.is_directory(base | ".git")
			if s.user_managed()
				warn("repo is not git: {{base}}")
				continue
			else
				let r = os.shell_execute("cd {{base}}; git clone {{s.url}} .")!

		# local changes?
		if not repo_is_clean(base)
			warn("repo has local changes: {{base}}")
			if conf.force
				let r = os.shell_execute("cd {{base}}; git restore .")!
			else
				continue

		if s.user_managed()
			if repo_is_ahead(base)
				warn("repo has local commits: {{base}}")
				if conf.force
					print("---force")
					repo_pull(base, true)
				else
					continue
			else
				repo_pull(base, false)
		else
			repo_pull(base, true)


func action_update(args: string[])
	action_pull(args)
	load_package_list()

	var needs_upgrade: string[]
	for p in conf.packages_installed
		for pp in list_find(conf.packages_remote, p.name)
			if pp.version != p.version
				needs_upgrade.add(p.name)

	install_begin()
	for name in needs_upgrade
		for p in list_find(conf.packages_remote, name)
			if not install_package(p)
				install_undo()
				os.exit(1)
	install_end()

